/*

PIO state machine programs for handling operations on the Z80 bus,
using 16 pins for address and 8 pins for data on a RP2350B

*/

// Z80 bus signals
// stick with Address on GPIO2-17
.define public PIN_A0 2         ; also A8 or D0 depending on mux settings
.define public PIN_NMREQ 18     ; N.... means Negative or Active Low, Memory Request
.define public PIN_NIOREQ 19    ; IO
.define public PIN_NWR 20       ; write
.define public PIN_NRD 21       ; read


.define ADDR_DELAY 12

.program eb2_addr_65C02
; calculates a pico address from the Z80's address and pushes it to the DMA channel
; pico_address = buffer_address + (Z80_address * 2)
; (* 2 because we need the u16 that contains the read/write flags AND data)
; 
; x = top 15 bits of pico dma buffer (set by pio_sm_exec)
;
.wrap_target
loop:   wait    1 gpio, PIN_NMREQ
        wait    0 gpio, PIN_NMREQ         ; wait for 1 -> 0
        set     pindirs, 0      ;input for all these pins
        mov     isr, x        ; push top 15 bits of the buffer address (in X) onto ISR

        set     y, ADDR_DELAY
delay:  jmp     y--, delay

        in      pins, 16        [1]      ; A0-A15
        nop                     [2]
        nop

        in      null, 1                  ; auto push - 17 bits
        push    noblock
.wrap


There are 4 pins,  MREQ going low will grab the address, and then DMA that back,
the DMA will trigger a second channel to read the data from memory and back to
FIFO.  This will trigger the eb2_access.  it will pull the FIFO data and
put the 8 bits to the output (to satisfy the READ).
If RD is low, it will simply switch the direction to output (all 1s)
ELSE IF WR is low, it will get data from the pins into OSR


NOTE: The original just used 8 pins, and a MUX - this mean the 8 pins would be reused
a lot and switched from in to 8.  same 8 pins and 3 side pins.

New version will use 8 pins for data the same
New version will use 16 pins for address which is different.
No mux.
Need to have two SMs - one to get the address, and one to get the WR/RD
bit and get/set the data.  Address SM run from GPIO2-17.  data DM from from 18-25
control signals in 26-29
Register content cannot be moved between state machines 
but X is only used for the address and not data.


.define public PIN_NMREQ 18     ; N.... means Negative or Active Low, Memory Request
.define public PIN_NWR 20       ; write
.define public PIN_NRD 21       ; read



.program eb2_access
; receives a 16bit word containg read/write flags + data from DMA
; high bytes contains flags, and low byte contains the data
; if read && read-enabled is set then outputs data to Z80 bus via the pins
; if write && write-enabled is set then gets data from Z80 bus via pins and pushes to DMA
.wrap_target
loop:
        pull    block                    ; get the flags + data into the OSR from the TXFIFO - from the CPU
        out     pins 8                   ; set up the data in case it's a read : move 8 bits in OSR to pins
        out     y, 1                     ; get the read-enabled flag : move remaining bit to y

        ; jmp_pin set the PIN_NWR (so if this is HIGH need to check for read)
        jmp     pin, read                ; jmp if Z80 read - that is look at the jmp_pin (from sm_config) and if it is high, jump to read
; Process Z80 write since jmp_pin (NWR) is low
write:
        out     y, 1                     ; get the write-enabled flag
        jmp     !y, loop                 ; jmp if no write access to this address
        in      pins 8
        jmp     loop
read:
; Process Z80 read
        jmp     !y, loop                ; jmp if no read access to this address
        in      pins 8                   ; grab the data on 8 pins into the ISR
        in      y 1                      ; and the extra pin is the read pin
        jmp     y, loop                  ; RD pin is still high
        mov     osr, !null               ; was allowed read access to this address, so move all 1s to OSR
        out     pindirs 8                ; move 8 bits from OSR to set the pin direction, (1 means output), and prep the mux with 0x110 for data transfer
        jmp loop
;
; BIG NOTE
; We don't have GPIO control of the DIR pin on the data mux ic 
; so we can't snoop the data bus when the Z80 reads from a peripheral
snoop:                                   
        out     y, 1                     ; move a bit from OSR into y, and again
        out     y, 1                     ; get the snoop flag
        jmp     !y, loop                 ; jmp if no snoop on this address
        in      null 8                   ; shift 8 bits to the ISR, from null
.wrap
